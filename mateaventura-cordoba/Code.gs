 * MATEAVENTURA CÓRDOBA · SERVIDOR GOOGLE APPS SCRIPT
 * Versión educativa 1.0 · Código para script vinculado a una Google Sheet PRIVADA.
 * Propiedades del script obligatorias: SHEET_ID, TEACHER_SECRET, MAIL_TO.
 * NO PUBLICAR la hoja, la nómina, claves ni propiedades del script.
 * Roster privado, hoja "Alumnos": ID | Nombre | Apellido | Clave | Modo | Activo
 */
const C = Object.freeze({
  ROSTER:'Alumnos', PROGRESS:'Progreso', REPORTS:'Reportes',
  PROG_HEADERS:['ID_ALUMNO','ACTUALIZADO','ESTADO_JSON'],
  REP_HEADERS:['ID_INFORME','REGISTRADO','ID_ALUMNO','NOMBRE_APELLIDO','INICIO','FIN','TIEMPO_MIN','ZONAS','NIVELES','PRIMER_INTENTO','SEGUNDO_INTENTO','TERCER_INTENTO','NO_LOGRADOS','DIFICULTADES','SUGERENCIA','EMAIL_ESTADO','EMAIL_FECHA','EMAIL_ERROR']
});

function doGet() {
  return HtmlService.createHtmlOutputFromFile('Index')
    .setTitle('MateAventura Córdoba · 5.º grado');
}

function normalize_(s) {
  return String(s == null ? '' : s).normalize('NFD').replace(/[\u0300-\u036f]/g,'')
    .trim().replace(/\s+/g,' ').toLowerCase();
}
function prop_(name) {
  const v=PropertiesService.getScriptProperties().getProperty(name);
  if (!v || !String(v).trim()) throw new Error('Configuración docente incompleta: falta '+name+'.');
  return String(v).trim();
}
function ss_(){return SpreadsheetApp.openById(prop_('SHEET_ID'));}
function sheet_(name,heads) {
  const ss=ss_();let sheet=ss.getSheetByName(name);
  if (!sheet) {
    sheet=ss.insertSheet(name);sheet.appendRow(heads);sheet.setFrozenRows(1);
    sheet.getRange(1,1,1,heads.length).setFontWeight('bold').setBackground('#1f548d').setFontColor('#ffffff');
  }
  return sheet;
}
function roster_() {
  const s=ss_().getSheetByName(C.ROSTER);
  if(!s)throw new Error('No existe la pestaña Alumnos con la nómina privada.');
  const rows=s.getDataRange().getDisplayValues();
  if (rows.length<2)throw new Error('La nómina de Alumnos está vacía.');
  const expected=['ID','Nombre','Apellido','Clave','Modo','Activo'];
  if(expected.some((x,i)=>normalize_(rows[0][i])!==normalize_(x)))throw new Error('Encabezados de Alumnos incorrectos. Usá: '+expected.join(' | '));
  return rows.slice(1);
}
function loginStudent(first,last,pin) {
  if(typeof first!=='string'||typeof last!=='string'||typeof pin!=='string')throw new Error('Datos de ingreso inválidos.');
  if(first.length>50||last.length>60||pin.length>32||pin.length<6)throw new Error('Datos de ingreso fuera de rango.');
  const student=roster_().find(r=>r[0] && normalize_(r[1])===normalize_(first) && normalize_(r[2])===normalize_(last) && r[3]===pin && !['no','inactivo','false','0'].includes(normalize_(r[5])));
  if (!student)return {ok:false,message:'Nombre, apellido o código no reconocido. Consultá a tu docente.'};
  const info={id:String(student[0]).trim(),name:String(student[1]).trim()+' '+String(student[2]).trim(),mode:normalize_(student[4])==='adaptado'?'adaptado':'principal'};
  info.resetAt=resetEpoch_(info.id);
  const token=Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,'');
  CacheService.getScriptCache().put('student:'+token,JSON.stringify(info),21600);
  let row=getProgress_(info.id);if(row&&Number(row.resetAt||0)!==info.resetAt)row=null;
  if(row)normalizeCurrentStars_(row);
  return {ok:true,name:info.name,mode:info.mode,token:token,progress:row,resetAt:info.resetAt};
}
function authorized_(token) {
  if(typeof token!=='string'||!/^[0-9a-f]{64}$/i.test(token))throw new Error('Sesión inválida. Volvé a ingresar.');
  const v=CacheService.getScriptCache().get('student:'+token);
  if(!v)throw new Error('La sesión caducó. Volvé a ingresar para sincronizar.');
  const u=JSON.parse(v);if(Number(u.resetAt||0)!==resetEpoch_(u.id))throw Error('La docente reinició la partida. Volvé a ingresar.');return u;
}
function getProgress_(id) {
  const s=sheet_(C.PROGRESS,C.PROG_HEADERS), last=s.getLastRow();if(last<2)return null;
  const data=s.getRange(2,1,last-1,3).getValues();
  const r=data.find(x=>String(x[0])===id);if(!r)return null;
  try {const p=JSON.parse(String(r[2]));return p&&typeof p==='object'?p:null}
  catch(e){return null}
}
function validateProgress_(p) {
  if(!p||typeof p!=='object'||Array.isArray(p)||typeof p.completed!=='object'||!p.levels)throw new Error('Progreso malformado.');
  const allowed=['LONG','PER','TRI'];
  if(!allowed.includes(p.world))throw new Error('Zona inválida.');
  if(Object.keys(p.completed).length>1200)throw new Error('Demasiados ejercicios.');
  for(const id of Object.keys(p.completed))if(!/^(LONG|STAT|CAP|MASS|PER|TRI)-(?:[NA][1-5]|G[1-4])-\d\d$/.test(id))throw new Error('ID de ejercicio inválido.');
  if(!Number.isFinite(p.stars)||!Number.isFinite(p.coins)||p.stars<0||p.coins<0)throw new Error('Puntos inválidos.');
  const txt=JSON.stringify(p);if(txt.length>45000)throw new Error('Progreso demasiado grande.');
  return txt;
}
function saveStudentProgress(token,p) {
  const u=authorized_(token);validateProgress_(p);if(Number(p.resetAt||0)!==Number(u.resetAt||0))throw Error('Progreso anterior al reinicio. Volvé a ingresar.');
  const lock=LockService.getScriptLock();lock.waitLock(20000);
  try {
    if(Number(u.resetAt||0)!==resetEpoch_(u.id))throw Error('La docente reinició la partida. Volvé a ingresar.');
    normalizeCurrentStars_(p);const stored=getProgress_(u.id);if(stored?.selectionV14)p.selectionV14=stored.selectionV14;else delete p.selectionV14;const data=validateProgress_(p);
    const s=sheet_(C.PROGRESS,C.PROG_HEADERS),last=s.getLastRow();
    let target=0;
    if(last>=2){let ids=s.getRange(2,1,last-1,1).getValues();for(let i=0;i<ids.length;i++){if(String(ids[i][0])===u.id){target=i+2;break}}}
    const row=[u.id,new Date(),data];if(target)s.getRange(target,1,1,3).setValues([row]);else s.appendRow(row);
    return {ok:true,stored:true};
  }finally{lock.releaseLock()}
}
function safeLabel_(x,max){const t=String(x||'').replace(/[\r\n\x00-\x1f]/g,' ').slice(0,max);return /^[=+\-@]/.test(t)?'\''+t:t;}
function validateReport_(r) {
  if(!r||typeof r!=='object'||!(/^[a-zA-Z0-9-]{8,100}$/).test(String(r.id)))throw new Error('ID de informe inválido.');
  if(!Number.isFinite(Number(r.durationSec))||r.durationSec<0||r.durationSec>86400)throw new Error('Duración inválida.');
  if(!Number.isFinite(Number(r.events))||r.events<1||r.events>400)throw new Error('Cantidad de ejercicios inválida.');
  for(const k of ['correct1','correct2','correct3','failed'])if(!Number.isInteger(Number(r[k]))||r[k]<0||r[k]>400)throw new Error('Conteo inválido: '+k);
  if(r.correct1+r.correct2+r.correct3+r.failed!==r.events)throw new Error('Conteos inconsistentes.');
  if(!Array.isArray(r.worlds)||r.worlds.length>6||r.worlds.some(x=>!['LONG','STAT','CAP','MASS','PER','TRI'].includes(x)))throw new Error('Mundos inválidos.');
  if(!r.topics||typeof r.topics!=='object'||Object.keys(r.topics).some(k=>!['LONG','STAT','CAP','MASS','PER','TRI'].includes(k)))throw new Error('Temas inválidos.');
  if(!r.levelMap||typeof r.levelMap!=='object'||Object.keys(r.levelMap).some(k=>!['LONG','STAT','CAP','MASS','PER','TRI'].includes(k)))throw new Error('Niveles inválidos.');
  if(r.evidence!==undefined){
    if(!Array.isArray(r.evidence)||r.evidence.length>1200)throw Error('Registro de respuestas inválido.');
    for(const e of r.evidence){const q=MP_BANK.find(q=>q.id===e?.id);if(!q||typeof e.choice!=='string'||!q.options.some(o=>normalize_(o)===normalize_(e.choice))||typeof e.feedbackShown!=='boolean')throw Error('Respuesta de informe inválida.');}
  }
  return true;
}
function detail_(r){return pedagogicalFeedbackV18(r,MP_BANK)}

function cumulative_(id){
  const s=sheet_(C.REPORTS,C.REP_HEADERS),last=s.getLastRow();
  const result={sessions:0,minutes:0,first:0,second:0,third:0,failed:0,worlds:{}};
  if(last<2)return result;
  // Leé solo las columnas necesarias: C ID y J-M conteos.
  const records=s.getRange(2,1,last-1,13).getValues();
  for(const row of records){if(String(row[2])!==id)continue;result.sessions++;result.minutes+=Number(row[6])||0;String(row[7]||'').split(' / ').filter(Boolean).forEach(w=>result.worlds[w]=true);result.first+=Number(row[9])||0;result.second+=Number(row[10])||0;result.third+=Number(row[11])||0;result.failed+=Number(row[12])||0}
  return result;
}
function mailBody_(row) {
  const c=cumulative_(String(row[2]));
  return [
   'MATEAVENTURA CÓRDOBA · DEVOLUCIÓN PEDAGÓGICA',
   'Estudiante: '+row[3], 'ID interno: '+row[2], 'Inicio: '+row[4], 'Fin: '+row[5],
   'Tiempo: '+row[6]+' minutos', 'Mundos: '+row[7], 'Niveles: '+row[8],
   'Correctos 1.º intento: '+row[9], 'Correctos 2.º intento: '+row[10],
   'Correctos 3.º intento: '+row[11], 'No logrados: '+row[12],
   String(row[13]), '',
   'INFORME ACUMULADO: '+c.sessions+' sesiones; '+c.minutes+' minutos; zonas '+Object.keys(c.worlds).join(', ')+'; 1.º intento '+c.first+
   '; 2.º intento '+c.second+'; 3.º intento '+c.third+'; no logrados '+c.failed+'.',
   '', 'Registro en planilla: '+row[0],
   'Nota: información formativa. Revisar junto al trabajo en clase; el navegador no es un entorno de evaluación antifraude.'
  ].join('\n');
}
function tryMail_(s,rowNumber) {
  const row=s.getRange(rowNumber,1,1,18).getValues()[0];
  if(String(row[15])==='ENVIADO')return {emailed:true};
  try {
    if(MailApp.getRemainingDailyQuota()<1)return {emailed:false,reason:'CUOTA_DIARIA_AGOTADA'};
    MailApp.sendEmail({to:prop_('MAIL_TO'),subject:'[MateAventura] '+safeLabel_(row[3],70)+' · '+safeLabel_(row[0],85),body:mailBody_(row),name:'MateAventura Córdoba'});
    s.getRange(rowNumber,16,1,3).setValues([['ENVIADO',new Date(),'']]);
    return {emailed:true};
  }catch(e){s.getRange(rowNumber,16,1,3).setValues([['PENDIENTE','',safeLabel_(e.message,300)]]);return {emailed:false,reason:'ERROR_ENVIO'}}
}
function storeReport_(u,r) {
  validateReport_(r);
  const lock=LockService.getScriptLock();lock.waitLock(25000);
  try {
    if(u.id!=='TEST'&&Number(u.resetAt||0)!==resetEpoch_(u.id))throw Error('La docente reinició la partida. Volvé a ingresar.');
    const s=sheet_(C.REPORTS,C.REP_HEADERS);const n=s.getLastRow();
    if(n>=2){const ids=s.getRange(2,1,n-1,1).getDisplayValues();
      for(let i=0;i<ids.length;i++)if(ids[i][0]===String(r.id)){
        const owner=s.getRange(i+2,3).getDisplayValue();if(owner!==u.id)throw new Error('Informe duplicado con otra identidad.');
        return {stored:true,emailed:s.getRange(i+2,16).getDisplayValue()==='ENVIADO',duplicate:true};
      }
    }
    const worldnames=(r.worlds||[]).map(w=>({LONG:'Alberdi',STAT:'Jerónimo del Barco',CAP:'Parque Sarmiento',MASS:'Mercado Norte',PER:'Plaza Colón',TRI:'Parque de las Tejas'}[w]||w)).join(' / ');
    const levels=Object.entries(r.levelMap||{}).map(([k,v])=>`${k}: nivel ${Math.min(5,Number(v)||1)}`).join(' / ');
    const row=[String(r.id),new Date(),u.id,u.name,safeLabel_(r.startedAt,40),safeLabel_(r.finishedAt,40),Math.round(Number(r.durationSec)/60),
       worldnames,levels,Number(r.correct1),Number(r.correct2),Number(r.correct3),Number(r.failed),detail_(r),safeLabel_(r.suggestion,350),'PENDIENTE','',''];
    s.appendRow(row);const nr=s.getLastRow();SpreadsheetApp.flush();
    const result=tryMail_(s,nr);
    return {stored:true,emailed:result.emailed,reason:result.reason||''};
  }finally{lock.releaseLock()}
}
function submitStudentReport(token,r) {const u=authorized_(token);if(!r||Number(r.resetAt||0)!==Number(u.resetAt||0))throw Error('Informe anterior al reinicio. No se guardó.');return storeReport_(u,r)}
function secureEq_(a,b) {
  // Comparación de hashes en tiempo aproximadamente constante (propiedad secreta nunca vuelve al cliente).
  const hx=s=>Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(s)).map(v=>(v+256)%256);
  const aa=hx(a),bb=hx(b);let d=0;for(let i=0;i<aa.length;i++)d|=aa[i]^bb[i];return d===0;
}
function teacherTestReport(secret) {
  if(typeof secret!=='string'||secret.length<16||!secureEq_(secret,prop_('TEACHER_SECRET')))
    throw new Error('Clave docente incorrecta (o menor a 16 caracteres).');
  const id='TEST-'+Utilities.getUuid();
  const sample={id,startedAt:new Date().toISOString(),finishedAt:new Date().toISOString(),durationSec:120,events:2,correct1:1,correct2:1,correct3:0,failed:0,topics:{LONG:{first:1,second:1,third:0,fail:0}},worlds:['LONG'],levelMap:{LONG:1},suggestion:'PRUEBA TÉCNICA: verificar registro y recepción en el correo de la docente.'};
  return storeReport_({id:'TEST',name:'PRUEBA DOCENTE · NO ES ALUMNO'},sample);
}

/** Ejecutar manualmente desde el editor para comprobar las tres propiedades y crear hojas de reportes. */
function prepararServidor_(){
  const s=ss_();prop_('MAIL_TO');prop_('TEACHER_SECRET');roster_();
  sheet_(C.REPORTS,C.REP_HEADERS);sheet_(C.PROGRESS,C.PROG_HEADERS);
  MailApp.getRemainingDailyQuota();Logger.log('CONFIGURADO: '+s.getName());
}
/** Activador programable por horas (ejemplo: cada 6 horas) para reintentar emails PENDIENTES. */
function reenviarInformesPendientes_(){
  const lock=LockService.getScriptLock();if(!lock.tryLock(15000))return;
  try{const s=sheet_(C.REPORTS,C.REP_HEADERS),last=s.getLastRow();if(last<2)return;
    const states=s.getRange(2,16,last-1,1).getValues();
    for(let i=0;i<states.length;i++){
      if(String(states[i][0])!=='PENDIENTE')continue;
      if(MailApp.getRemainingDailyQuota()<1)break;
      tryMail_(s,i+2);
    }
  }finally{lock.releaseLock()}
}

// Barrio seguro: estado efímero; nunca se publican apellidos, claves ni tokens.
const MP_EMOTES=['¡Hola! 👋','¡Bien ahí! 👏','¡Vamos! 💪','¿Jugamos? 🎮','¡Gracias! 😊','¡Chocá los cinco! ✋'];
function mpRead_(k,d){const s=CacheService.getScriptCache().get('mp:'+k);return s?JSON.parse(s):d}
function mpWrite_(k,v,ttl){CacheService.getScriptCache().put('mp:'+k,JSON.stringify(v),ttl||60)}
function mpLock_(fn){const l=LockService.getScriptLock();l.waitLock(10000);try{return fn()}finally{l.releaseLock()}}
function mpRoom_(b){if(!['LONG','PER','TRI'].includes(b))throw Error('Barrio inválido');const r=mpRead_('room:'+b,{players:{},events:[]});const now=Date.now();Object.keys(r.players).forEach(id=>{if(now-r.players[id].ts>20000)delete r.players[id]});r.events=r.events.filter(e=>now-e.ts<12000);return r}
function mpPublic_(g,u){if(!g||!g.members.includes(u.id)||Date.now()-g.ts>600000)return null;const out={id:g.id,from:g.members[0],to:g.members[1],names:g.names,status:g.status,scores:g.scores,submitted:g.submitted};if(g.status==='playing')out.questions=g.questions[u.id].map(q=>({id:q.id,question:q.question,kind:q.kind,options:q.options,visual:q.visual,world:q.world,difficulty:q.difficulty,topic:q.topic,art:q.art||null,recorda:q.recorda||null,lessonId:q.lessonId||null}));return out}
function mpHeartbeat(token,barrio,x,y,avatar){const u=authorized_(token);if(!Number.isFinite(x)||!Number.isFinite(y))throw Error('Posición inválida');return mpLock_(()=>{const prev=mpRead_('location:'+u.id,null);if(prev&&prev!==barrio){const old=mpRoom_(prev);delete old.players[u.id];mpWrite_('room:'+prev,old)}const r=mpRoom_(barrio);r.players[u.id]={id:u.id,nombre:u.name.split(/\s+/)[0],avatar:(['mora','matt','messonic'].includes(avatar)||/^av(?:0[1-9]|1[0-2])$/.test(typeof avatar==='string'?avatar:''))?avatar:'av01',x:Math.max(4,Math.min(96,x)),y:Math.max(12,Math.min(88,y)),barrio,ts:Date.now()};mpWrite_('room:'+barrio,r);mpWrite_('location:'+u.id,barrio);const g=mpRead_('invite:'+mpRead_('current:'+u.id,''),null);return {id:u.id,players:Object.values(r.players),events:r.events.filter(e=>e.to==='all'||e.to===u.id||e.from===u.id),challenge:mpPublic_(g,u)}})}
function mpLeave(token){const u=authorized_(token);return mpLock_(()=>{const b=mpRead_('location:'+u.id,null);if(b){const r=mpRoom_(b);delete r.players[u.id];mpWrite_('room:'+b,r)}return {ok:true}})}
function mpSendEmote(token,to,emoteId){const u=authorized_(token);if(!Number.isInteger(emoteId)||!MP_EMOTES[emoteId])throw Error('Saludo inválido');return mpLock_(()=>{const b=mpRead_('location:'+u.id,null),r=mpRoom_(b);if(!r.players[u.id]||(to!=='all'&&!r.players[to]))throw Error('Compañero desconectado');if(Date.now()-(mpRead_('rate:'+u.id,0))<2000)throw Error('Esperá un poquito antes de saludar');mpWrite_('rate:'+u.id,Date.now());r.events.push({id:Utilities.getUuid(),from:u.id,to,text:MP_EMOTES[emoteId],ts:Date.now()});r.events=r.events.slice(-32);mpWrite_('room:'+b,r);return {ok:true}})}
function mpInviteChallenge(token,to){const u=authorized_(token);return mpLock_(()=>{const b=mpRead_('location:'+u.id,null),r=mpRoom_(b);if(to===u.id||!r.players[u.id]||!r.players[to])throw Error('Elegí un compañero conectado');for(const id of [u.id,to]){const old=mpRead_('invite:'+mpRead_('current:'+id,''),null);if(old&&['pending','playing'].includes(old.status)&&Date.now()-old.ts<600000)throw Error('Ya hay una invitación o desafío en curso')}
 const id=Utilities.getUuid(),g={id,members:[u.id,to],names:[r.players[u.id].nombre,r.players[to].nombre],barrio:b,status:'pending',ts:Date.now(),scores:{},submitted:{},questions:{}};mpWrite_('invite:'+id,g,600);g.members.forEach(i=>mpWrite_('current:'+i,id,600));return {ok:true}})}
function mpRespond(token,id,accept){const u=authorized_(token);return mpLock_(()=>{const g=mpRead_('invite:'+id,null);if(typeof accept!=='boolean')throw Error('Respuesta inválida');if(!g||g.members[1]!==u.id||g.status!=='pending'||Date.now()-g.ts>600000)throw Error('Invitación vencida');g.status=accept===true?'playing':'declined';if(accept===true){const roster=roster_();for(const member of g.members){const row=roster.find(r=>String(r[0]).trim()===member);if(!row)throw Error('Alumno no disponible');const scope=normalize_(row[4])==='adaptado'?'adaptado':'principal';const u2={id:member,mode:scope,resetAt:resetEpoch_(member)},p=selectionProgress_(u2);const level=Math.max(1,Math.min(4,p.levels[g.barrio]||1));g.questions[member]=[];for(let i=0;i<5;i++)g.questions[member].push(modeQuestion_(pickUnseen_(p,g.barrio,level,[],true),scope));writeSelectionProgress_(u2,p);if(g.questions[member].length!==5)throw Error('Banco incompleto')}}mpWrite_('invite:'+id,g,600);return {ok:true}})}
function mpComplete(token,id,answers){const u=authorized_(token);return mpLock_(()=>{const g=mpRead_('invite:'+id,null);if(!g||!g.members.includes(u.id)||!['playing','done'].includes(g.status)||Date.now()-g.ts>600000)throw Error('Desafío vencido');if(!g.submitted[u.id]){if(!Array.isArray(answers)||answers.length!==5||answers.some(a=>typeof a!=='string'||a.length>120))throw Error('Respuestas inválidas');g.scores[u.id]=g.questions[u.id].reduce((n,q,i)=>{const a=normalize_(answers[i]),b=normalize_(q.answer);const num=s=>Number(s.replace(',','.'));return n+(q.kind==='choice'?a===b:(a!==''&&Number.isFinite(num(a))&&Math.abs(num(a)-num(b))<1e-8)?1:0)},0);g.submitted[u.id]=true;if(g.members.every(i=>g.submitted[i]))g.status='done';mpWrite_('invite:'+id,g,600)}return mpPublic_(g,u)})}

