// Public wrappers keep the existing manual setup and six-hour resend trigger working.
function prepararServidorManual(){return prepararServidor_()}
function reenviarInformesPendientesManual(){return reenviarInformesPendientes_()}

// Persistent reset generation prevents stale browsers from restoring cleared progress.
function resetEpoch_(id){const cache=CacheService.getScriptCache(),key='reset:'+id;const hit=cache.get(key);if(hit!==null)return Number(hit)||0;const value=Number(PropertiesService.getScriptProperties().getProperty(key))||0;cache.put(key,String(value),21600);return value}
/** Teacher-only destructive operation. Never called automatically or by a trigger. */
function resetStudentProgress(code,teacherSecret){
 if(typeof teacherSecret!=='string'||teacherSecret.length<16||!secureEq_(teacherSecret,prop_('TEACHER_SECRET')))throw Error('Clave docente incorrecta. No se modificó ningún registro.');
 if(typeof code!=='string'||code.length<6||code.length>32)throw Error('Código de alumno inválido.');
 return mpLock_(()=>{const matches=roster_().filter(r=>r[3]===code);if(matches.length!==1)throw Error('Código no reconocido o ambiguo. No se modificó ningún registro.');const u=matches[0],id=String(u[0]).trim();const resetAt=Math.max(Date.now(),resetEpoch_(id)+1);PropertiesService.getScriptProperties().setProperty('reset:'+id,String(resetAt));CacheService.getScriptCache().put('reset:'+id,String(resetAt),21600);
  const counts={progress:0,reports:0};for(const cfg of [[C.PROGRESS,0,'progress'],[C.REPORTS,2,'reports']]){const sh=ss_().getSheetByName(cfg[0]);if(!sh||sh.getLastRow()<2)continue;const rows=sh.getDataRange().getValues();for(let i=rows.length-1;i>=1;i--)if(String(rows[i][cfg[1]])===id){sh.deleteRow(i+1);counts[cfg[2]]++}}
  const b=mpRead_('location:'+id,null);if(b){const r=mpRoom_(b);delete r.players[id];mpWrite_('room:'+b,r)}const current=mpRead_('current:'+id,'');if(current){const g=mpRead_('invite:'+current,null);if(g){g.status='cancelled';mpWrite_('invite:'+current,g,60)}}SpreadsheetApp.flush();return {ok:true,resetAt,cleared:counts,message:'Progreso e historial de informes reiniciados. Las sesiones anteriores ya no son válidas. Los correos ya enviados no se pueden retirar.'};
 });
}

// v9: session-validated, server-side marking. No reports, sheets or mail are written here.
function checkStudentAnswer(token,id,value,phase){
 const u=authorized_(token);if(typeof id!=='string'||typeof value!=='string'||value.length>240)throw Error('Respuesta inválida.');
 const q=MP_BANK.find(x=>x.id===id);if(!q)throw Error('Actividad no disponible para esta sesión.');
 if(!Number.isInteger(phase)||phase<0||phase>=(q.steps?q.steps.length:1))throw Error('Paso inválido.');
 return mpLock_(()=>{if(Number(u.resetAt||0)!==resetEpoch_(u.id))throw Error('La docente reinició la partida. Volvé a ingresar.');const cache=CacheService.getScriptCache(),key='mark:'+u.id+':'+u.resetAt+':'+id;let state=JSON.parse(cache.get(key)||'{"passed":[],"tries":{}}');
 if(phase>0&&!state.passed.includes(phase-1))throw Error('Primero resolvé el paso anterior.');
 const v=q.steps?q.steps[phase]:q;const chosen=v.options.find(o=>normalize_(o)===normalize_(value));if(chosen===undefined)throw Error('Elegí una opción disponible.');
 const correct=normalize_(value)===normalize_(v.answer);state.tries[phase]=(state.tries[phase]||0)+1;if(correct&&!state.passed.includes(phase))state.passed.push(phase);cache.put(key,JSON.stringify(state),21600);
 return {correct:correct,feedback:adaptText_(correct?v.solution:v.feedbackByOption[chosen],u.mode),solution:adaptText_(correct||state.tries[phase]>=3?v.solution:'',u.mode),phase:phase};
 });
}

// v14 canonical bank and durable, per-student no-repeat selection (same across modes).
function adaptText_(s,mode){return mode==='adaptado'?String(s).toUpperCase():s}
function modeQuestion_(q,mode){if(!q||mode!=='adaptado')return q;const out=JSON.parse(JSON.stringify(q));for(const k of ['question','answer','solution','hint1','hint2','recorda','mission','topic'])if(typeof out[k]==='string')out[k]=out[k].toUpperCase();out.options=out.options.map(s=>s.toUpperCase());out.feedbackByOption=Object.fromEntries(Object.entries(out.feedbackByOption).map(([k,v])=>[k.toUpperCase(),v.toUpperCase()]));return out}
function selectionProgress_(u){const p=getProgress_(u.id)||{completed:{},levels:{LONG:1,PER:1,TRI:1},world:'LONG',stars:0,coins:0,medals:[],avatar:{preset:'av01'},updatedAt:0,resetAt:u.resetAt};if(!['LONG','PER','TRI'].includes(p.world))p.world='LONG';p.selectionV14=p.selectionV14||{};normalizeCurrentStars_(p);return p}
function writeSelectionProgress_(u,p){if(Number(u.resetAt||0)!==resetEpoch_(u.id))throw Error('La docente reinició la partida. Volvé a ingresar.');const data=validateProgress_(p),s=sheet_(C.PROGRESS,C.PROG_HEADERS),last=s.getLastRow();let row=0;if(last>=2){const ids=s.getRange(2,1,last-1,1).getValues();for(let i=0;i<ids.length;i++)if(String(ids[i][0])===u.id){row=i+2;break}}const values=[u.id,new Date(),data];if(row)s.getRange(row,1,1,3).setValues([values]);else s.appendRow(values)}
function pickUnseen_(p,world,level,avoid,practice){const all=MP_BANK.filter(q=>q.world===world&&q.difficulty===level);const pool=practice?all:all.filter(q=>!p.completed[q.id]&&!avoid.includes(q.id));if(!pool.length)return null;const key=world+':'+level;let state=p.selectionV14[key]||{seen:[],cycle:0};let q=pool.find(q=>!state.seen.includes(q.id));if(!q){state={seen:[],cycle:state.cycle+1};q=pool[0]}state.seen.push(q.id);p.selectionV14[key]=state;return q}
function nextStudentQuestion(token,world,level,avoid){const u=authorized_(token);if(!['LONG','PER','TRI'].includes(world)||!Number.isInteger(level)||level<1||level>4)throw Error('Barrio o nivel inválido.');if(!Array.isArray(avoid)||avoid.length>1200||avoid.some(x=>typeof x!=='string'||x.length>40))throw Error('Progreso inválido.');return mpLock_(()=>{const p=selectionProgress_(u),q=pickUnseen_(p,world,level,avoid,false);if(q)writeSelectionProgress_(u,p);return q})}

function normalizeCurrentStars_(p){p.stars=MP_BANK.reduce((sum,q)=>sum+({first:3,second:2,third:1}[p.completed?.[q.id]?.outcome]||0),0);return p}

// Deterministic formative feedback from recorded choices; never infer diagnoses or mastery.
function pedagogicalFeedbackV18(report,bank){
 const tidy=s=>String(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toLowerCase();
 const clip=(s,n=150)=>String(s||'').replace(/\s+/g,' ').slice(0,n);
 const rows=Array.isArray(report.evidence)?report.evidence:[],topics={LONG:'Conversión de longitud',PER:'Perímetro',TRI:'Triángulos'};
 const result=[];
 for(const [world,name] of Object.entries(topics)){
  const events=rows.map(e=>{const q=bank.find(q=>q.id===e.id&&q.world===world);if(!q)return null;const choice=q.options.find(o=>tidy(o)===tidy(e.choice));if(choice===undefined)return null;return {q,choice,correct:tidy(choice)===tidy(q.answer),feedbackShown:e.feedbackShown===true}}).filter(Boolean);
  if(!events.length){const old=report.topics?.[world],n=old?['first','second','third','fail'].reduce((a,k)=>a+(Number(old[k])||0),0):0;result.push(name+'\n'+(n?`Hay ${n} ítems en el resumen, pero no se guardaron las opciones elegidas. No alcanza para describir logros o patrones de error; pistas no registradas.`:'Sin respuestas registradas. Todavía no hay datos para describir logros, dificultades, precisión, nivel o pistas.')+'\nPróximo paso: resolver 3 situaciones breves del tema y registrar las respuestas.');continue}
  const byId=new Map();for(const e of events){if(!byId.has(e.q.id))byId.set(e.q.id,[]);byId.get(e.q.id).push(e)}
  const first=[...byId.values()].map(v=>v[0]),right=events.filter(e=>e.correct),independent=first.filter(e=>e.correct),wrong=events.filter(e=>!e.correct),level=Math.max(...events.map(e=>e.q.difficulty)),hints=events.filter(e=>e.feedbackShown).length;
  let lines=[name,`${byId.size} ítems; aciertos ${right.length}/${events.length} respuestas (${Math.round(right.length/events.length*100)}%); primer intento ${independent.length}/${byId.size}. Nivel trabajado ${level}/4. Pistas/devoluciones por error mostradas: ${hints}; otras ayudas no medidas.`];
  if(byId.size<5)lines.push('Muestra breve: no alcanza para afirmar dominio del tema.');
  if(independent.length){const e=independent[0];lines.push(`Ya logra en esta muestra: eligió «${clip(e.choice,65)}» al primer intento (${e.q.id}). ${clip(e.q.solution)}`)}
  else if(right.length)lines.push('Logro con apoyo: llegó a una respuesta correcta después de revisar; aún falta observar una resolución al primer intento.');
  else lines.push('Todavía no se registró una respuesta correcta; conviene acompañar una situación paso a paso.');
  if(wrong.length){const grouped=new Map();for(const e of wrong){const key=e.q.id+'|'+e.choice;const prev=grouped.get(key);if(prev)prev.n++;else grouped.set(key,{e,n:1})}const patterns=[...grouped.values()].sort((a,b)=>b.n-a.n);for(const {e,n} of patterns.slice(0,2))lines.push(`A revisar: eligió «${clip(e.choice,55)}» en lugar de «${clip(e.q.answer,55)}» (${e.q.id}${n>1?', '+n+' veces':''}). ${clip(e.q.solution)}`);lines.push(`Practicar: rehacer con ${world==='LONG'?'la escala de unidades':world==='PER'?'el borde dibujado y los lados marcados':'un dibujo con lados y ángulos señalados'} ese ítem y otro parecido; pedir que explique qué cambió. No se atribuye una causa al error sin escucharlo.`)}
  else lines.push('Sin errores observados en esta muestra. Practicar dos situaciones nuevas del mismo nivel y pedir que explique cómo decidió.');
  result.push(lines.join('\n'));
 }
 return 'DEVOLUCIÓN PEDAGÓGICA · ESTA SESIÓN\nDatos de respuestas registradas; no es un diagnóstico ni acredita dominio.\n\n'+result.join('\n\n');
}

